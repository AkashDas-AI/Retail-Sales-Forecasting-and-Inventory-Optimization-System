# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# This file provides an illustrative template for environment variables.
# Copy this file to '.env' if you wish to override local configuration defaults.
# Real credentials, tokens, or private secrets must NEVER be committed to Git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Optional Execution Overrides
RANDOM_SEED=42

